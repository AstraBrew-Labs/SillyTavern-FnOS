#!/bin/bash
### 配置变更前校验：仅服务端口

USER_MSG_FILE="${TRIM_TEMP_LOGFILE:-/dev/null}"

PORT_VALUE="${wizard_port:-}"

if [ -z "${PORT_VALUE}" ]; then
    exit 0
fi

case "${PORT_VALUE}" in
    *[!0-9]*)
        printf '%s\n' "服务端口必须为数字，请填写 5000-65535 之间的端口。" > "${USER_MSG_FILE}"
        exit 1
        ;;
esac

if [ "${PORT_VALUE}" -lt 5000 ] || [ "${PORT_VALUE}" -gt 65535 ]; then
    printf '%s\n' "服务端口需在 5000-65535 之间，当前填写：${PORT_VALUE}。" > "${USER_MSG_FILE}"
    exit 1
fi

exit 0
